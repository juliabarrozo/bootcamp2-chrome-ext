{
  "name": "bootcamp2-chrome-ext",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/extension",
    "apps/tests"
  ],
  "scripts": {
    "build": "echo 'Build root'",
    "build:web": "npm --workspace=apps/web run build",
    "build:api": "npm --workspace=apps/api run build",
    "start:web": "npm --workspace=apps/web run dev",
    "start:api": "npm --workspace=apps/api run dev",
    "test:e2e": "npm --workspace=apps/tests run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  },
  "dependencies": {
    "playwright": "^1.56.1"
  }
}
